   ],
   "source": [
    "# Определяем массовые сегменты (>120 компаний)\n",
    "segment_counts = df_clean['market_original'].value_counts()\n",
    "mass_segments = segment_counts[segment_counts > 120].index\n",
    "\n",
    "# Фильтруем только массовые сегменты\n",
    "pivot_mass = pivot[mass_segments]\n",
    "\n",
    "# Ищем сегменты с ростом в 2014 по сравнению с 2013\n",
    "growing = []\n",
    "for segment in mass_segments:\n",
    "    if 2013 in pivot_mass.index and 2014 in pivot_mass.index:\n",
    "        val_2013 = pivot_mass.loc[2013, segment] if pd.notna(pivot_mass.loc[2013, segment]) else 0\n",
    "        val_2014 = pivot_mass.loc[2014, segment] if pd.notna(pivot_mass.loc[2014, segment]) else 0\n",
    "        \n",
    "        if val_2014 > val_2013 > 0:\n",
    "            growth = (val_2014 - val_2013) / val_2013 * 100\n",
    "            growing.append((segment, growth))\n",
    "\n",
    "# Сортируем по росту\n",
    "growing.sort(key=lambda x: x[1], reverse=True)\n",
    "\n",
    "print(f\"Массовых сегментов: {len(mass_segments)}\")\n",
    "print(f\"Сегментов с ростом в 2014: {len(growing)}\")"
   ]
