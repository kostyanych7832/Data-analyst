   "source": [
    "Определите компании с аномальным объёмом общего финансирования — используйте метод IQR отдельно по каждому сегменту. Напомним, что все нишевые сегменты должны быть объединены в одну группу, а средние — в другую.\n",
    "\n",
    "Определите сегменты рынка с наибольшей долей компаний, получивших аномальное финансирование, и выведите топ таких сегментов."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 78,
   "metadata": {
    "id": "0AjgR0DKch35"
   },
   "outputs": [],
   "source": [
    "# Определение выбросов методом IQR по сегментам\n",
    "df['is_outlier'] = False\n",
    "\n",
    "# Определяем выбросы отдельно для каждого сегмента\n",
    "for segment in df['market'].unique():\n",
    "    segment_data = df[df['market'] == segment]['funding_total_usd']\n",
    "    \n",
    "    # Рассчитываем квартили и IQR\n",
    "    Q1 = segment_data.quantile(0.25)\n",
    "    Q3 = segment_data.quantile(0.75)\n",
    "    IQR = Q3 - Q1\n",
    "    \n",
    "    # Границы для выбросов\n",
    "    lower_bound = Q1 - 1.5 * IQR\n",
    "    upper_bound = Q3 + 1.5 * IQR\n",
    "    \n",
    "    # Помечаем выбросы\n",
    "    mask = (df['market'] == segment) & (\n",
    "        (df['funding_total_usd'] < lower_bound) | \n",
    "        (df['funding_total_usd'] > upper_bound)\n",
    "    )\n",
    "    df.loc[mask, 'is_outlier'] = True"
   ]
  },
