   "source": [
    "# Анализ выбросов по сегментам\n",
    "outlier_analysis = df.groupby('market').agg(\n",
    "    total_companies=('funding_total_usd', 'count'),\n",
    "    outlier_companies=('is_outlier', 'sum')\n",
    ")\n",
    "\n",
    "outlier_analysis['outlier_percentage'] = (outlier_analysis['outlier_companies'] / \n",
    "                                         outlier_analysis['total_companies'] * 100)\n",
